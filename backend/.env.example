PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5173

# Database
MONGODB_URI=mongodb://localhost:27017/beauty_parlour_db

# Security & Secrets
JWT_SECRET=super_secret_jwt_access_key_change_in_production_12345
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_change_in_production_67890
COOKIE_SECRET=super_secret_cookie_signing_key_abcde

# Payment Gateway (Razorpay / Stripe / Cashfree)
PAYMENT_GATEWAY_KEY_ID=your_payment_key_id
PAYMENT_GATEWAY_KEY_SECRET=your_payment_key_secret
PAYMENT_WEBHOOK_SECRET=your_payment_webhook_secret

# Email / SMS Service
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
